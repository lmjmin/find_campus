<?xml version="1.0" encoding="UTF-8"?>

<mapper namespace="com.example.find_campus.dao.IUserDao">

    <resultMap id="UserResultMap" type="com.example.find_campus.dto.UserDto">
        <id property="userId" column="USER_ID"/>
        <result property="loginId" column="LOGIN_ID"/>
        <result property="password" column="PASSWORD"/>
        <result property="userName" column="USER_NAME"/>
        <result property="studentNo" column="STUDENT_NO"/>
        <result property="phone" column="PHONE"/>
        <result property="email" column="EMAIL"/>
        <result property="role" column="ROLE"/>
        <result property="status" column="STATUS"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <select id="findByLoginId" resultMap="UserResultMap">
        SELECT
            USER_ID,
            LOGIN_ID,
            PASSWORD,
            USER_NAME,
            STUDENT_NO,
            PHONE,
            EMAIL,
            ROLE,
            STATUS,
            CREATED_AT,
            UPDATED_AT
        FROM USERS
        WHERE LOGIN_ID = #{loginId}
    </select>

    <select id="countByLoginId" resultType="int">
        SELECT COUNT(*)
        FROM USERS
        WHERE LOGIN_ID = #{loginId}
    </select>

    <select id="countByEmail" resultType="int">
        SELECT COUNT(*)
        FROM USERS
        WHERE EMAIL = #{email}
    </select>

    <insert id="insertUser" parameterType="com.example.find_campus.dto.UserDto">
        INSERT INTO USERS (
            USER_ID,
            LOGIN_ID,
            PASSWORD,
            USER_NAME,
            STUDENT_NO,
            PHONE,
            EMAIL,
            ROLE,
            STATUS,
            CREATED_AT
        ) VALUES (
            SEQ_USERS.NEXTVAL,
            #{loginId},
            #{password},
            #{userName},
            #{studentNo},
            #{phone},
            #{email},
            'USER',
            'ACTIVE',
            SYSDATE
        )
    </insert>

</mapper>